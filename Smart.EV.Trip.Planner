 import java.awt.*;
import java.awt.event.*;

public class EVTripPlanner extends Frame implements ActionListener {

    Label l1, l2, l3, l4, l5, l6;

    TextField tfSource, tfDestination, tfDistance, tfBattery;

    Choice vehicleChoice;

    Checkbox ac;

    Checkbox fastCharge, normalCharge;
    CheckboxGroup chargeGroup;

    List stationList;

    Button calculate;

    TextArea report;

    MenuBar mb;
    Menu file;
    MenuItem exit;

    public EVTripPlanner() {

        setTitle("EV Trip Planner");
        setSize(700,650);
        setLayout(null);
        // Background color
setBackground(new Color(230, 245, 255));

// Fonts
Font titleFont = new Font("Arial", Font.BOLD, 22);
Font labelFont = new Font("Arial", Font.BOLD, 14);
Font textFont = new Font("Arial", Font.PLAIN, 14);
Font buttonFont = new Font("Arial", Font.BOLD, 16);

        // Menu
        mb = new MenuBar();
        file = new Menu("File");
        exit = new MenuItem("Exit");

        exit.addActionListener(new ActionListener() {
            public void actionPerformed(ActionEvent e) {
                dispose();
            }
        });

        file.add(exit);
        mb.add(file);
        setMenuBar(mb);
        Label title = new Label("SMART EV TRIP PLANNER", Label.CENTER);
title.setBounds(120,20,450,35);
title.setFont(titleFont);
title.setForeground(new Color(0,102,204));
add(title);

        l1 = new Label("Source");
        l1.setBounds(50,50,120,25);
        add(l1);

        tfSource = new TextField();
        tfSource.setBounds(180,50,180,25);
        add(tfSource);

        l2 = new Label("Destination");
        l2.setBounds(50,90,120,25);
        add(l2);

        tfDestination = new TextField();
        tfDestination.setBounds(180,90,180,25);
        add(tfDestination);

        l3 = new Label("Distance (km)");
        l3.setBounds(50,130,120,25);
        add(l3);

        tfDistance = new TextField();
        tfDistance.setBounds(180,130,180,25);
        add(tfDistance);

        l4 = new Label("Battery (%)");
        l4.setBounds(50,170,120,25);
        add(l4);

        tfBattery = new TextField();
        tfBattery.setBounds(180,170,180,25);
        add(tfBattery);
        tfSource.setBackground(Color.WHITE);
tfDestination.setBackground(Color.WHITE);
tfDistance.setBackground(Color.WHITE);
tfBattery.setBackground(Color.WHITE);

tfSource.setFont(textFont);
tfDestination.setFont(textFont);
tfDistance.setFont(textFont);
tfBattery.setFont(textFont);

        l5 = new Label("Vehicle");
        l5.setBounds(50,210,120,25);
        add(l5);

        vehicleChoice = new Choice();
        vehicleChoice.add("Car");
        vehicleChoice.add("Bike");
        vehicleChoice.add("Bus");
        vehicleChoice.add("Truck");
        vehicleChoice.setBounds(180,210,180,25);
        add(vehicleChoice);
        vehicleChoice.setBackground(Color.WHITE);
vehicleChoice.setFont(textFont);

        ac = new Checkbox("AC ON");
        ac.setBounds(50,250,100,25);
        add(ac);
        ac.setBackground(new Color(230,245,255));
ac.setFont(textFont);

        l6 = new Label("Charging Type");
        l6.setBounds(50,290,120,25);
        add(l6);
        l1.setFont(labelFont);
l2.setFont(labelFont);
l3.setFont(labelFont);
l4.setFont(labelFont);
l5.setFont(labelFont);
l6.setFont(labelFont);

l1.setForeground(new Color(0,51,102));
l2.setForeground(new Color(0,51,102));
l3.setForeground(new Color(0,51,102));
l4.setForeground(new Color(0,51,102));
l5.setForeground(new Color(0,51,102));
l6.setForeground(new Color(0,51,102));

        chargeGroup = new CheckboxGroup();

        fastCharge = new Checkbox("Fast Charging", chargeGroup, true);
        fastCharge.setBounds(180,290,150,25);
        add(fastCharge);

        normalCharge = new Checkbox("Normal Charging", chargeGroup, false);
        normalCharge.setBounds(180,320,150,25);
        add(normalCharge);
fastCharge.setBackground(new Color(230,245,255));
normalCharge.setBackground(new Color(230,245,255));

fastCharge.setFont(textFont);
normalCharge.setFont(textFont);
        
        Label ls = new Label("Charging Stations");
        ls.setBounds(420,50,150,25);
        add(ls);

        stationList = new List();
        stationList.setBounds(420,80,180,120);
        add(stationList);
        stationList.setBackground(Color.WHITE);
stationList.setForeground(Color.BLUE);
stationList.setFont(textFont);

        calculate = new Button("Calculate");
        calculate = new Button("PLAN TRIP");
calculate.setBackground(new Color(0,153,76));
calculate.setForeground(Color.WHITE);
calculate.setFont(buttonFont);
        calculate.setBounds(180,370,120,35);
        calculate.addActionListener(this);
        add(calculate);

        report = new TextArea();
        report.setBounds(50,430,600,160);
        add(report);
        report.setBackground(Color.WHITE);
report.setForeground(Color.BLACK);
report.setFont(new Font("Monospaced", Font.PLAIN, 14));

        addWindowListener(new WindowAdapter() {
            public void windowClosing(WindowEvent e) {
                dispose();
            }
        });

        setVisible(true);
    }

    public void actionPerformed(ActionEvent e) {

        String source = tfSource.getText();
        String destination = tfDestination.getText();

        double distance = Double.parseDouble(tfDistance.getText());
        double battery = Double.parseDouble(tfBattery.getText());

        String vehicle = vehicleChoice.getSelectedItem();

        double fullRange = 0;

        if(vehicle.equals("Car"))
            fullRange = 400;
        else if(vehicle.equals("Bike"))
            fullRange = 180;
        else if(vehicle.equals("Bus"))
            fullRange = 300;
        else
            fullRange = 500;

        double availableRange = battery/100*fullRange;

        if(ac.getState())
            availableRange -= availableRange*0.10;

        double chargeConsumed = (distance/fullRange)*100;
        double remaining = battery-chargeConsumed;

        stationList.removeAll();

        int stops = 0;

        if(distance>availableRange){

            double extra = distance-availableRange;

            stops=(int)Math.ceil(extra/fullRange);

            String[] stations={
                    "Chengalpattu",
                    "Villupuram",
                    "Trichy",
                    "Dindigul",
                    "Madurai",
                    "Salem",
                    "Erode",
                    "Coimbatore"
            };

            for(int i=0;i<stops && i<stations.length;i++)
                stationList.add(stations[i]);
        }

        String chargingType=chargeGroup.getSelectedCheckbox().getLabel();

        double cost;

        if(chargingType.equals("Fast Charging"))
            cost=stops*500;
        else
            cost=stops*300;

        double time=distance/60;

        report.setText(
    
                "=========== EV TRIP REPORT ===========\n\n"+
                "Source               : "+source+
                "\nDestination          : "+destination+
                "\nVehicle              : "+vehicle+
                "\nDistance Covered     : "+distance+" km"+
                "\nInitial Battery      : "+battery+" %"+
                "\nCharge Consumed      : "+String.format("%.2f",chargeConsumed)+" %"+
                "\nRemaining Battery    : "+String.format("%.2f",remaining)+" %"+
                "\nCharging Stops       : "+stops+
                "\nCharging Type        : "+chargingType+
                "\nEstimated Cost       : ₹"+cost+
                "\nTravel Time          : "+String.format("%.2f",time)+" Hours"+
                "\n\nTrip Status          : "+
                (remaining>=0?"Trip Possible":"Charging Required")
        );
    }

    public static void main(String args[]) {
        new EVTripPlanner();
    }
}
